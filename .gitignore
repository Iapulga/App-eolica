app_eolica.db
app_eolica.db-wal
app_eolica.db-shm
app_eolica_respaldo.db
*.sqlite
*.sqlite3
.backups/
*.db.bak

# ── Logs y archivos de diagnóstico ──────────────────────────
diagnostico.log
*.log

# ── Reportes y exportaciones generadas por la app ───────────
reportes/*.docx
reportes/*.xlsx
reportes/*.pdf
reportes/*.json

# ── Editor / IDE ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Sistema operativo ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Streamlit cache ─────────────────────────────────────────
.streamlit/secrets.toml

# ── Carpetas de trabajo / borradores ────────────────────────
scratch/
legacy/
Alfa app/

# ── Claude Code config local ────────────────────────────────
.claude/settings.local.json
