# ── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# ── Entornos virtuales ──────────────────────────────────────
venv/
.venv/
env/
.env/

# ── PyInstaller (output del build, no va al repo) ───────────
build/
dist/
*.spec.bak

# ── Bases de datos locales del usuario ──────────────────────
