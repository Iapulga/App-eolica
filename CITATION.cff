    given-names: "Alan David"
    email: "alandavidgomezmaestre@gmail.com"
repository-code: "https://github.com/alandavidgomezmaestre/sma2"
url: "https://github.com/alandavidgomezmaestre/sma2"
license: MIT
version: "0.9.0"
date-released: "2026-05-26"
keywords:
  - wind energy
  - AEP
  - wake modeling
  - LCOE
  - renewable energy
  - Streamlit
  - Python
  - WindPRO alternative
  - IEC 61400
